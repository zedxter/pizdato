# Copy to /etc/pizdato.env
BIND=127.0.0.1:8080
DATABASE_URL=sqlite:/var/lib/pizdato/votes.db?mode=rwc
COOKIE_SECURE=true
VOTE_IP_SALT=change-me-to-a-long-random-string
# Max POST /api/vote attempts per IP per rolling day (any outcome)
VOTE_IP_DAILY_LIMIT=10
VOTE_IP_MIN_INTERVAL_SECS=10
VOTE_SESSION_MIN_AGE_SECS=2
# After this many HTTP 403 vote responses in 24h, IP is blacklisted
# (its votes are excluded from public stats)
VOTE_IP_403_BLACKLIST_AFTER=5
RUST_LOG=info
