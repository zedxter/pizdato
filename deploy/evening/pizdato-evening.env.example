# Private ~/.config/pizdato-evening.env, chmod 600; never commit credentials.
# Model access: Nous Portal with NOUS_API_KEY from ~/.config/pizdato-channel.env. OpenRouter is disabled.
# Writer/discovery model (default openai/gpt-6.1-sol):
PIZDATO_EVENING_MODEL=openai/gpt-6.1-sol
# Reviewer model (proofreader, editor, verifier; default: the writer model). Morning: PIZDATO_MORNING_MODEL, else the writer model.
PIZDATO_EDITOR_MODEL=openai/gpt-6.1-sol
# Optional other HTTPS OpenAI-compatible endpoint; it needs its own PIZDATO_LLM_API_KEY (NOUS_API_KEY is bound to
# nousresearch.com). An openrouter.ai URL is refused.
# PIZDATO_LLM_BASE_URL=
# PIZDATO_LLM_API_KEY=
# Reasoning effort for OpenAI reasoning models (low|medium|high; default low). Reviewers = proofreader,
# editor and verifier. Measured on Nous Portal with full history: one review takes 5–14 s (low), 11–36 s (high).
PIZDATO_REASONING_EFFORT=high
PIZDATO_EDITOR_REASONING_EFFORT=high
# Run `bash ~/.local/share/pizdato-evening/tick.sh --check` after any change: it proves plain replies,
# strict JSON from every configured model and tool calls from the evening model, without publishing.
# Existing Composio For You consumer credential for the existing account:
COMPOSIO_CONSUMER_KEY=
