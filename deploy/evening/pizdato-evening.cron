# User crontab entry; the OS cron daemon schedules in the server timezone.
# Required server timezone: Europe/Berlin. Do not enable legacy 17:00 posting.
*/5 * * * * /bin/bash /home/danil/.local/share/pizdato-evening/tick.sh >> /home/danil/.local/state/pizdato-evening/cron.log 2>&1 # pizdato-evening
# The worker creates an edition only after 18:00 Berlin and resumes pending editions.
