# Copy useful keys to ~/.config/pizdato-channel.env (not committed).
# Telegram API id/hash usually live in ~/.config/telegram-mcp.env

# Required for posting (Telegram user account that owns the StoreSession):
# TELEGRAM_ACCOUNT_ID=
# Optional session layout overrides:
# TELEGRAM_SESSION_CWD=
# TELEGRAM_SESSION_NAME=

# OpenRouter for hourly verdicts and evening copy:
OPENROUTER_API_KEY=
PIZDATO_LLM_MODEL=deepseek/deepseek-v3.2
# Request deadline in milliseconds (invalid values use the default):
# PIZDATO_LLM_TIMEOUT_MS=60000

# PIZDATO_CHANNEL=@pizdato_net

# SQLite used by hourly news cron (same DB as the site API):
# PIZDATO_DB=/var/lib/pizdato/votes.db

# Optional owner peer for hourly/evening tech DMs (default: me / Saved Messages):
# PIZDATO_OWNER_PEER=me
