# pizdato.net — static frontend + API reverse proxy
pizdato.net {
	log {
		output file /var/log/caddy/pizdato-access.log {
			roll_size 50mb
			roll_keep 7
			roll_keep_for 168h
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /mcp* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /var/www/pizdato
		try_files {path} /index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
	}
}

www.pizdato.net {
	redir https://pizdato.net{uri} permanent
}
