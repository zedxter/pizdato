# pizdato.net — static frontend + API reverse proxy
pizdato.net {
	log {
		output file /var/log/caddy/pizdato-access.log {
			roll_size 50mb
			roll_keep 7
			roll_keep_for 168h
		}
	}

	# Security headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Frame-Options "DENY"
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-nxD7DF3yd/LTSbtwaRiXfuzozGmDvJcGWomwRXG7H1A=' https://mc.yandex.ru; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'; frame-src 'none'; object-src 'none'"

	# Old «Как это работает» URL — keep both /how and /how.html off the index fallback
	@legacy_how path /how /how/ /how.html
	redir @legacy_how /pizdato permanent

	# CORS for design assets (fonts, design.css)
	@design_cors path /design.css /fonts/*
	header @design_cors Access-Control-Allow-Origin "*"

	handle /api/* {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /health {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		root * /var/www/pizdato
		# Prefer real files, then MPA shells (e.g. /issledovanie → issledovanie.html),
		# then the SPA shell for the home page; anything else → 404.html with real 404.
		try_files {path} {path}.html {path}/index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
		# HTML shells must revalidate so nav/label renames are not stuck in browser cache
		@html path *.html /
		header @html Cache-Control "no-cache"
		@html_routes path /lenta /faq /pizdato /issledovanie /articles /articles/*
		header @html_routes Cache-Control "no-cache"
	}

	# Unknown paths: serve /404.html with HTTP 404 instead of index.html (200).
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
		header {
			Cache-Control "no-cache"
			X-Content-Type-Options nosniff
		}
	}
}

www.pizdato.net {
	redir https://pizdato.net{uri} permanent
}