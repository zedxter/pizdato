# pizdato.net — static frontend + API reverse proxy
# Existing VS Code tunnel path kept for compatibility.
pizdato.net {
	handle /_vs_code_z/* {
		uri strip_prefix /_vs_code_z
		reverse_proxy 127.0.0.1:42424
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /var/www/pizdato
		try_files {path} /index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
	}
}

www.pizdato.net {
	redir https://pizdato.net{uri} permanent
}
