#!/usr/bin/env bash
# Gitleaks pre-commit hook — block commit if a secret is being added.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks: not found, skipping pre-commit secret scan (CI still enforces)" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

mapfile -t files < <(
  { git diff --cached --name-only --diff-filter=ACM; git ls-files --others --exclude-standard; }     | sort -u     | grep -viE '(^|/)node_modules/|^\.git/|\.(png|jpe?g|gif|svg|ico|woff|woff2|ttf|lock)$'
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

declined=0
for f in "${files[@]}"; do
  content="$(git cat-file blob :"$f" 2>/dev/null || cat "$f" 2>/dev/null || true)"
  [ -z "$content" ] && continue

  set +e
  printf '%s\n' "$content" | gitleaks stdin --no-banner --redact=100 >/tmp/gitleaks-precommit.log 2>&1
  status=$?
  set -e

  if [ "$status" -ne 0 ]; then
    echo "gitleaks: SECRET detected in '$f'" >&2
    tail -6 /tmp/gitleaks-precommit.log >&2 || true
    declined=1
  fi
done

if [ "$declined" -ne 0 ]; then
  echo "ERROR: gitleaks detected a secret in the staged changes. Remove it before committing." >&2
  exit 1
fi

exit 0
